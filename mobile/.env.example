# Copiază fișierul în mobile/.env și completează valorile din Supabase (Project Settings → API Keys).
# Fără .env (sau cu valori goale), aplicația pornește în modul demo, cu date locale.
# După ce modifici .env, repornește `npm run dev:mobile`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
